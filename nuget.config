<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolItem="3" />
    <add key="Local-Dev" value="C:\Development\LocalNuget" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="Local-Dev">
      <package pattern="AkkaSync.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>